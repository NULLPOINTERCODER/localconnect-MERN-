<%- include("vendor/base.ejs") %>

<%= (labels) ? (labels.inventory) : ('Menu') %> Management


<link rel="stylesheet" href="/static/css/vendor/menu.css">



<script src="/static/js/vendor/menu.js"></script>



<div class="menu-container">
    <div class="menu-header-actions">
        <h3>Your <%= (labels) ? ((labels.inventory + ' Items')) : ('Menu Items') %></h3>
        <button class="btn-add-item" onclick="openAddModal()">
            <i class="fa-solid fa-plus"></i> <%= (labels) ? ('Add Item') : ('Add New Item') %>
        </button>
    </div>

    <div class="menu-items-grid">
        <% if (items && items.length) { items.forEach(function(item) { %>
        <div class="menu-item-card <% if (!item.is_available) { %>unavailable<% } %>" data-item-id="<%= item.id %>">
            <div class="item-image-container">
                <img src="<%= (item.image_file) ? ('/static/images/food/' + item.image_file) : ('/static/images/food/default.jpg') %>"
                    class="item-image" alt="<%= item.name %>"
                    onerror="this.src='https://via.placeholder.com/300x200?text=No+Image'">
                <div class="availability-toggle">
                    <label class="switch">
                        <input type="checkbox" <% if (item.is_available) { %>checked<% } %>
                            onchange="toggleAvailability(<%= item.id %>, this)">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>

            <div class="item-details">
                <div class="item-header">
                    <h4 class="item-name"><%= item.name %></h4>
                    <span class="category-badge <%= item.category.toLowerCase() %>">
                        <%= item.category %>
                    </span>
                </div>

                <% if (item.sub_name) { %>
                <p class="item-description"><%= item.sub_name %></p>
                <% } %>

                <div class="item-footer">
                    <div class="price-section">
                        <span class="price">₹<%= item.price %></span>
                    </div>

                    <div class="action-buttons">
                        <button class="btn-edit" onclick="openEditModal(<%= item.id %>)" title="Edit Item">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-delete" onclick="deleteItem(<%= item.id %>)" title="Delete Item">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <% }); } else { %>
        <div class="empty-state">
            <i class="fa-solid <%= (labels) ? (labels.icon) : ('fa-utensils') %>"></i>
            <h4>No <%= (labels) ? ((labels.inventory + ' Items')) : ('Menu Items') %> Yet</h4>
            <p>Start building your <%= (labels) ? (labels.inventory.toLowerCase()) : ('menu') %> by adding your first <%= (labels) ? ('item'.toLowerCase()) : ('item') %>!</p>
            <button class="btn-add-first" onclick="openAddModal()">
                <i class="fa-solid fa-plus"></i> <%= (labels) ? ('Add Item') : ('Add Your First Item') %>
            </button>
        </div>
        <% } %>
    </div>
</div>

<!-- Add/Edit Item Modal -->
<div id="itemModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitle"><%= (labels) ? ('Add Item') : ('Add New Menu Item') %></h3>
            <span class="close" onclick="closeModal()">&times;</span>
        </div>
        <div class="modal-body">
            <form id="itemForm" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="itemName"><%= (labels) ? (labels.item_name_label) : ('Item Name') %> *</label>
                    <input type="text" id="itemName" name="name" placeholder="e.g., Paneer Tikka" required>
                </div>

                <div class="form-group">
                    <label for="itemDescription"><%= (labels) ? (labels.item_description_label) : ('Description') %></label>
                    <input type="text" id="itemDescription" name="sub_name"
                        placeholder="e.g., Spicy grilled paneer with herbs">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="itemCategory"><%= (labels) ? (labels.category_field) : ('Category') %> *</label>
                        <select id="itemCategory" name="category" required>
                            <option value="">Select <%= (labels) ? (labels.category_field) : ('Category') %></option>
                            <% if (labels && labels.categories) { %>
                            <% if (labels.categories) { (labels.categories).forEach(cat => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                            <% }); } %>
                            <% } else { %>
                            <option value="Veg">Vegetarian</option>
                            <option value="Non-Veg">Non-Vegetarian</option>
                            <option value="Beverages">Beverages</option>
                            <option value="Desserts">Desserts</option>
                            <option value="Snacks">Snacks</option>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="itemPrice"><%= (labels) ? (labels.price_label) : ('Price') %> (₹) *</label>
                        <input type="number" id="itemPrice" name="price" placeholder="180" min="1" step="0.01" required>
                    </div>
                </div>

                <div class="form-group">
                    <label for="itemImage"><%= (labels) ? ('item') : ('Item') %> Photo</label>
                    <div class="file-input-container">
                        <input type="file" id="itemImage" name="image" accept="image/*" class="file-input">
                        <div class="file-input-display">
                            <i class="fa-solid fa-camera"></i>
                            <span class="file-text">Choose photo from device</span>
                        </div>
                        <div id="imagePreview" class="image-preview"></div>
                    </div>
                </div>

                <div class="modal-buttons">
                    <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
                    <button type="submit" class="btn-save" id="saveBtn">
                        <i class="fa-solid fa-plus"></i> <%= (labels) ? ('Add Item') : ('Add Item') %>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal">
    <div class="modal-content delete-modal">
        <div class="modal-header">
            <h3>Delete <%= (labels) ? ('item') : ('Menu Item') %></h3>
            <span class="close" onclick="closeDeleteModal()">&times;</span>
        </div>
        <div class="modal-body">
            <div class="delete-icon">
                <i class="fa-solid fa-trash-can"></i>
            </div>
            <p>Are you sure you want to delete this <%= (labels) ? ('item'.toLowerCase()) : ('menu item') %>?</p>
            <p class="delete-warning">This action cannot be undone.</p>

            <div class="modal-buttons">
                <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
                <button type="button" class="btn-delete-confirm" id="confirmDeleteBtn">
                    <i class="fa-solid fa-trash"></i> Delete <%= (labels) ? ('item') : ('Item') %>
                </button>
            </div>
        </div>
    </div>
</div>
